# Copy to .env and fill in. NEVER commit .env.
# AGENT_GAMES_HMAC_SECRET: from the Agent Games dashboard, "Rotate Secret".
# Copy the one-time plaintext exactly. The service refuses to start without it.
AGENT_GAMES_HMAC_SECRET=

# KURIER_API_KEY: from the kurier.xyz dashboard (create an account, generate a key).
# Optional. Without it the service still generates + locally verifies proofs and
# returns them, but on-chain finalization is skipped (see README.md).
KURIER_API_KEY=

# Kurier base URL. Mainnet default. For testnet use https://api-testnet.kurier.xyz/api/v1
KURIER_BASE_URL=https://api.kurier.xyz/api/v1

# When true (and KURIER_API_KEY is set) an APPROVE is only returned after the
# Kurier job reaches Finalized. Set to false to accept locally-verified proofs.
KURIER_REQUIRE_FINALIZED=true

# Max time (ms) to wait for a Kurier job to reach Finalized, per request.
KURIER_FINALIZE_TIMEOUT_MS=20000

# Interval (ms) between Kurier job-status polls (Kurier docs use 5000).
KURIER_POLL_INTERVAL_MS=5000

# Hard per-request deadline (ms). The platform enforces 60s.
REQUEST_TIMEOUT_MS=60000

# Safety margin (ms) reserved for serializing + sending the response.
RESPONSE_MARGIN_MS=5000

# Allowed clock skew (ms) for issued_at / deadline_at validation.
CLOCK_SKEW_MS=120000

# Server bind address and port. The platform needs a PUBLIC https URL.
HOST=0.0.0.0
PORT=3000

# Circuit artifacts (defaults point at ./circuits). Override only if relocated.
# GATEKEEPER_WASM=./circuits/gatekeeper.wasm
# GATEKEEPER_ZKEY=./circuits/gatekeeper_final.zkey

# Used-proof store (replay protection). Defaults to ./data/used-proofs.json
# USED_PROOFS_PATH=./data/used-proofs.json
# USED_PROOFS_MAX_ENTRIES=10000

# taskId encoding. See README.md assumption A1. Do not change unless the
# platform publishes a different encoding.
# TASK_ID_ENCODING=keccak256-mod-p

NODE_ENV=production
